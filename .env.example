# Senhas. IEDUCAR_DB_PASSWORD pode ficar de fora: o Compose usa ieducar.
MOODLE_DB_PASSWORD=
MOODLE_ADMIN_PASSWORD=

# Credenciais das APIs. SYNC_API_TOKEN é o Bearer dos endpoints do monolito.
IEDUCAR_TOKEN=
IEDUCAR_ACCESS_KEY=
MOODLE_TOKEN=
SYNC_API_TOKEN=

# Escopo da sincronização. O DemoSeeder grava a instituição 1 e as escolas 2 e 3
# no ano corrente.
IEDUCAR_INSTITUTION_ID=1
IEDUCAR_SCHOOL_ID=2,3
IEDUCAR_YEAR=2026

# Volumes já existentes. Em instalação nova, omita este bloco.
# COMPOSE_EXTERNAL_VOLUMES=true
# IEDUCAR_POSTGRES_VOLUME=i-educar_postgres
# MOODLE_POSTGRES_VOLUME=moodle_postgres_data
# MOODLE_APP_VOLUME=moodle_moodle_data
# MOODLE_FILES_VOLUME=moodle_moodledata_data

# Padrões já aplicados pelo Compose. Descomente só para mudar.
# IEDUCAR_URL=http://ieducar
# IEDUCAR_PATH=./services/i-educar
# IEDUCAR_HOST_UID=1001
# IEDUCAR_HOST_GID=1001
# IEDUCAR_DB_NAME=ieducar
# IEDUCAR_DB_USER=ieducar
# IEDUCAR_DB_PASSWORD=ieducar
# IEDUCAR_HTTP_PORT=80
# MOODLE_URL=http://moodle:8080
# MOODLE_DB_NAME=bitnami_moodle
# MOODLE_DB_USER=bn_moodle
# MOODLE_ADMIN_USER=admin
# MOODLE_ADMIN_EMAIL=admin@example.com
# MOODLE_HTTP_PORT=8080
# MOODLE_HTTPS_PORT=8443
# Categoria Diversos e papéis Professor (3) e Estudante (5) de uma instalação Moodle nova.
# MOODLE_CATEGORY_ID=1
# MOODLE_TEACHER_ROLE_ID=3
# MOODLE_STUDENT_ROLE_ID=5
# MONOLITH_PORT=8000
# HTTP_TIMEOUT=15
# COMPOSE_EXTERNAL_VOLUMES=false
# IEDUCAR_POSTGRES_VOLUME=t1-monolith_ieducar-postgres
# MOODLE_POSTGRES_VOLUME=t1-monolith_moodle-postgres
# MOODLE_APP_VOLUME=t1-monolith_moodle-app
# MOODLE_FILES_VOLUME=t1-monolith_moodle-files
