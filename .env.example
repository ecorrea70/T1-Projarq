IEDUCAR_URL=http://ieducar
# API REST (Sanctum), para alunos com matrícula.
IEDUCAR_TOKEN=
# API legada, para professores e catálogo de turmas/disciplinas dos dois fluxos.
IEDUCAR_ACCESS_KEY=
# Escopo obrigatório para sincronizar professores e matrículas dos alunos.
IEDUCAR_INSTITUTION_ID=
IEDUCAR_SCHOOL_ID=
IEDUCAR_YEAR=
MOODLE_URL=http://moodle:8080
MOODLE_TOKEN=
# Categoria existente e ID real do papel Professor, obtidos na administração Moodle.
MOODLE_CATEGORY_ID=
MOODLE_TEACHER_ROLE_ID=
# ID real do papel Estudante (consulte Definir papéis na administração).
MOODLE_STUDENT_ROLE_ID=
SYNC_API_TOKEN=
HTTP_TIMEOUT=15

# Submodule do i-Educar, com seu próprio .env preparado.
IEDUCAR_PATH=./services/i-educar
IEDUCAR_HOST_UID=1001
IEDUCAR_HOST_GID=1001
IEDUCAR_DB_NAME=ieducar
IEDUCAR_DB_USER=ieducar
IEDUCAR_DB_PASSWORD=
MOODLE_DB_NAME=bitnami_moodle
MOODLE_DB_USER=bn_moodle
MOODLE_DB_PASSWORD=
MOODLE_ADMIN_USER=admin
MOODLE_ADMIN_PASSWORD=
MOODLE_ADMIN_EMAIL=admin@example.com
MONOLITH_PORT=8000
IEDUCAR_HTTP_PORT=80
MOODLE_HTTP_PORT=8080
MOODLE_HTTPS_PORT=8443

# false cria volumes próprios; true usa quatro volumes existentes.
COMPOSE_EXTERNAL_VOLUMES=false
IEDUCAR_POSTGRES_VOLUME=t1-monolith_ieducar-postgres
MOODLE_POSTGRES_VOLUME=t1-monolith_moodle-postgres
MOODLE_APP_VOLUME=t1-monolith_moodle-app
MOODLE_FILES_VOLUME=t1-monolith_moodle-files
